{{- /* Driver template for the go StatsHouse client.
   Rendered by the e2e harness (Go text/template) from the single generated
   metric stream (e2e/stream.go). "Pinned seed" = injection: the exact writes
   below are the same bytes the harness asserts against, there is no per-language
   RNG. This is a harness-owned program, NOT the upstream client's test_template.txt.

   Every real write goes through the client's Historic bypass path
   (*Client.NamedCountHistoric/NamedValuesHistoric/NamedUniquesHistoric → write
   with an explicit past ts), so each observation serializes immediately with its
   own timestamp — bucket assignment is exact regardless of the client's 1s flush
   jitter. Close() does the final synchronous flush; the harness waits for this
   process to exit before asserting.

   KIND DISPATCH. The stream carries the full metric matrix (counter,
   value, value_p, unique, stag). counter/stag → NamedCountHistoric; value →
   NamedValuesHistoric with a literal payload; value_p/unique large payloads → a
   deterministic generator loop (genSpec) reproducing the EXACT formula in
   quantile.go (uint64 wrapping LCG, >>32, %1000, r*r/1000.0), so the multi-
   thousand-point payload is bit-identical across go/rust/cpp and the harness's
   expected model.

   BURST PACING (go client only). The pinned client's tcpConn.Write is a non-
   blocking send into a 512-packet channel (tcpConnBucketCount, statshouse.go;
   the send goroutine drains it to the socket). A large Historic payload is its
   OWN ~full packet — it cannot batch with other items — so the value_p writes
   (2k values ≈ one 16 KB packet each) and especially the big-unique writes
   (100k values ≈ thirteen 64 KB packets per write) fire ≈340 full packets far
   faster than the goroutine drains. The channel overflows and the overflowed
   packets drop SILENTLY — counted only in __src_client_write_err — which is the
   exact u_approx loss a review run caught (64939 vs 100000±2%). A short sleep
   between these large writes lets the goroutine drain so every value reaches the
   agent. Small writes (counters, value literals, the small unique) batch many
   items per packet and need no pacing. rust/cpp flush over their own transports
   and are paced in their templates (or need no pacing).

   COLD-START PRE-WARM. The agent drops every packet for a metric name not yet in
   its local mapping (cmd/statshouse/worker.go: fillMetricMeta → MetricNotFound,
   return false) even though it asynchronously asks metadata to auto-create the
   metric. Creation → journal broadcast → agent mapping-cache update is async, so a
   single short-lived driver loses its entire payload to that window. To defeat
   this we first send one "seed" per metric with a KIND-MATCHING write — value/
   unique metrics MUST seed with a value/unique write so auto-create derives the
   right kind (the counter default would otherwise mis-type them); value_p is
   pre-created by the harness so its seed (a value write) is harmless. The seed is
   itself dropped (it is the first packet, so it hits the same unmapped window),
   but its arrival is what triggers the auto-create — then poll /api/metrics-list
   until metadata has created every metric. At that point the agent's longpoll
   journal subscription has the mapping too; a 2s settle covers any subscription
   skew, after which the real stream maps cleanly. Seeds use ts=base-60 (outside
   the asserted [base, base+70] window, inside the 24h HistoricWindow) so that even
   if one landed it could not perturb an assertion bucket; the client skips count=0
   writes, so the count seed must carry count>0. */ -}}
package main

import (
	"encoding/json"
	"fmt"
	"io"
	"math"
	"net/http"
	"os"
	"time"

	"github.com/VKCOM/statshouse-go"
)

func main() {
	addr := os.Getenv("STATSHOUSE_ADDR")
	if addr == "" {
		addr = statshouse.DefaultAddr
	}
	// TCP is the reliable client→agent metric path on :13337: the agent's RPC
	// listener hijacks every connection carrying the "statshousev" handshake
	// (cmd/statshouse/statshouse.go hijackConnection → internal/receiver TCP
	// metric receiver), and this client sends exactly that handshake
	// (client_conn.go). UDP is lossy across containers — a dropped datagram is
	// silent — so the harness mandates TCP here. The Historic writes still carry
	// explicit timestamps.
	// MaxBucketSize lifts the client's per-bucket reservoir cap (default 1024,
	// statshouse.go:defaultMaxBucketSize). appendUnique (client_bucket.go) keeps
	// only MaxBucketSize sampled values once a bucket overflows: UniquesHistoric
	// routes through it, so the ~100k-distinct u_approx metric would otherwise be
	// reservoir-sampled to exactly 1024 distinct on the wire and the agent's
	// ChUnique thinning estimator (>65536) — the very path u_approx exists to
	// exercise — would never activate. 1<<18 (256k) > bigUniqueDistinct (100k) and
	// > uniquesHashMaxSize (65536), so every distinct value reaches the agent and
	// the ±2% band asserts the thinning estimate, not the client's reservoir.
	// ValuesHistoric appends directly (no cap), so value/value_p payloads are
	// unaffected; counters/stags never touch the cap.
	c := statshouse.NewClientEx(statshouse.ConfigureArgs{StatsHouseAddr: addr, Network: "tcp", MaxBucketSize: 1 << 18})

	metrics := []string{
		{{- range .Metrics}}
		{{printf "%q" .}},
		{{- end}}
	}
	const seedTS = {{.SeedTS}}

	// One kind-matching seed per metric: dropped on arrival (unmapped), but it is
	// the packet that triggers metadata auto-create for the name. value/unique
	// MUST seed with their kind so auto-create derives value/unique, not the
	// counter default (value_p is pre-created, so its value seed is harmless).
	{{- range .Seeds}}
	{{- if eq .Kind "value"}}
	c.NamedValueHistoric({{printf "%q" .Name}}, statshouse.NamedTags{}, 1, seedTS)
	{{- else if eq .Kind "unique"}}
	c.NamedUniqueHistoric({{printf "%q" .Name}}, statshouse.NamedTags{}, 1, seedTS)
	{{- else}}
	c.NamedCountHistoric({{printf "%q" .Name}}, statshouse.NamedTags{}, 1, seedTS)
	{{- end}}
	{{- end}}

	// STATSHOUSE_API_ADDR is the api container's <ip>:10888 on the run network
	// (the harness publishes a host port for its own assertions, but the driver
	// container reaches the api by its in-network IP). Empty → fixed fallback.
	apiAddr := os.Getenv("STATSHOUSE_API_ADDR")
	if apiAddr == "" {
		time.Sleep(5 * time.Second)
	} else if !waitMetricsExist("http://"+apiAddr+"/api/metrics-list", metrics) {
		// Pre-warm timed out: metrics were never created, so the agent↔agg path
		// is down. Fail fast with preWarmExit BEFORE the real writes so the
		// harness reports one clear cause, not N "series absent" failures. The
		// seeds were written ~60s ago and the client's 1s flush fired many times
		// during the poll, so there is no tail batch to lose by skipping Close.
		os.Exit({{.PreWarmExit}})
	} else {
		// Settle so the agent's longpoll mapping-cache subscription catches up to
		// metadata before the real (counted) writes begin.
		time.Sleep(2 * time.Second)
	}

	// The real stream: one Historic write per generated observation, dispatched on
	// the metric kind. Tags render as positional [2]string pairs; empty values are
	// emitted verbatim so the client's fillTag empty-drop is exercised on the wire.
	{{- range .Writes}}
	{{- if or (eq .Kind "counter") (eq .Kind "stag")}}
	c.NamedCountHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, {{printf "%v" .Count}}, {{.TS}})
	{{- else if eq .Kind "value"}}
	c.NamedValuesHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, []float64{ {{- range .Values}}{{printf "%v" .}}, {{end}} }, {{.TS}})
	{{- else if eq .Kind "value_nan"}}
	c.NamedValuesHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, []float64{math.NaN()}, {{.TS}})
	{{- else if eq .Kind "value_inf"}}
	c.NamedValuesHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, []float64{math.Inf(1)}, {{.TS}})
	{{- else if eq .Kind "value_p"}}
	{{- if eq .Gen.Kind "valueUniform"}}
	{
		v := make([]float64, {{.Gen.N}})
		for i := 0; i < {{.Gen.N}}; i++ {
			v[i] = float64(i)
		}
		c.NamedValuesHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, v, {{.TS}})
		time.Sleep(2 * time.Millisecond) // burst pacing — see BURST PACING above
	}
	{{- else if eq .Gen.Kind "valueSkewed"}}
	{
		v := make([]float64, {{.Gen.N}})
		x := uint64(0x9e3779b97f4a7c15)
		for i := 0; i < {{.Gen.N}}; i++ {
			x = x*6364136223846793005 + 1442695040888963407
			r := uint32(x>>32) % 1000
			v[i] = float64(r) * float64(r) / 1000.0
		}
		c.NamedValuesHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, v, {{.TS}})
		time.Sleep(2 * time.Millisecond) // burst pacing — see BURST PACING above
	}
	{{- end}}
	{{- else if eq .Kind "unique"}}
	{{- if eq .Gen.Kind "uniqueDistinct"}}
	{
		u := make([]int64, {{.Gen.N}})
		for i := 0; i < {{.Gen.N}}; i++ {
			u[i] = int64(i + 1)
		}
		c.NamedUniquesHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, u, {{.TS}})
		time.Sleep(50 * time.Millisecond) // burst pacing — see BURST PACING above
	}
	{{- else if eq .Gen.Kind "uniqueDedup"}}
	{
		u := make([]int64, {{.Gen.N}}*2)
		for i := 0; i < {{.Gen.N}}*2; i++ {
			u[i] = int64(i%{{.Gen.N}}) + 1
		}
		c.NamedUniquesHistoric({{printf "%q" .Metric}}, statshouse.NamedTags{ {{- range .Tags}}{ {{printf "%q" .Key}}, {{printf "%q" .Val}} }, {{end}} }, u, {{.TS}})
	}
	{{- end}}
	{{- end}}
	{{- end}}

	// Close flushes the in-flight packet (c.send(0)) and closes the socket;
	// without it the last batch is lost. Then a brief settle so the agent finishes
	// draining the datagrams before the container exits.
	if err := c.Close(); err != nil {
		fmt.Fprintln(os.Stderr, "statshouse-go driver: close error:", err)
		os.Exit(1)
	}
	time.Sleep(time.Second)
	fmt.Printf("statshouse-go driver: wrote {{len .Writes}} observations to %s\n", addr)
}

// metricsListReply is the minimal slice of /api/metrics-list's reply: the known
// metric names under data.metrics.
type metricsListReply struct {
	Data struct {
		Metrics []struct {
			Name string `json:"name"`
		} `json:"metrics"`
	} `json:"data"`
}

// waitMetricsExist blocks until /api/metrics-list reports every metric name,
// which means metadata has auto-created them all. Polls for up to 60s; returns
// true once all are present, false on timeout. A timeout is a HARD failure: the
// agent↔agg path is almost certainly down (metrics never get created), so main
// exits non-zero (preWarmExit=3) rather than writing a payload the harness would
// then report as N cryptic "series absent" failures.
func waitMetricsExist(listURL string, metrics []string) bool {
	want := make(map[string]bool, len(metrics))
	for _, m := range metrics {
		want[m] = true
	}
	deadline := time.Now().Add(60 * time.Second)
	for time.Now().Before(deadline) {
		known, err := fetchMetricNames(listURL)
		if err == nil {
			missing := false
			for m := range want {
				if !known[m] {
					missing = true
					break
				}
			}
			if !missing {
				fmt.Printf("statshouse-go driver: all %d metric(s) created after pre-warm\n", len(metrics))
				return true
			}
		}
		time.Sleep(500 * time.Millisecond)
	}
	fmt.Fprintln(os.Stderr, "statshouse-go driver: FAIL: pre-warm timed out (metrics never created — agent/agg path down?)")
	return false
}

// preWarmClient is the HTTP client for the cold-start /api/metrics-list poll. A
// bounded timeout so a hung/unreachable api cannot stall the driver past its exit.
var preWarmClient = &http.Client{Timeout: 5 * time.Second}

// fetchMetricNames returns the set of metric names the api currently knows. A
// request/parse failure returns an error so the caller just retries.
func fetchMetricNames(listURL string) (map[string]bool, error) {
	resp, err := preWarmClient.Get(listURL + "?full=1")
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	if resp.StatusCode != http.StatusOK {
		_, _ = io.Copy(io.Discard, resp.Body)
		return nil, fmt.Errorf("HTTP %d", resp.StatusCode)
	}
	body, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, err
	}
	var r metricsListReply
	if err := json.Unmarshal(body, &r); err != nil {
		return nil, err
	}
	out := make(map[string]bool, len(r.Data.Metrics))
	for _, m := range r.Data.Metrics {
		out[m.Name] = true
	}
	return out, nil
}
